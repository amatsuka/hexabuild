// Единственное, ради чего заведён плагин: из C# в браузер иначе не позвонить, а
// `Application.Quit()` в WebGL вкладку не закрывает. Ничего другого сюда не класть.
mergeInto(LibraryManager.library, {
  // Браузер закрывает только то окно, которое открыл сам скрипт: на обычной вкладке вызов
  // тихо ничего не сделает, и это ограничение браузера, а не игры. Поэтому C# после него
  // всё равно зовёт `Application.Quit()` — партия останавливается в любом случае.
  HexColonyCloseTab: function () {
    window.close();
  },
});
